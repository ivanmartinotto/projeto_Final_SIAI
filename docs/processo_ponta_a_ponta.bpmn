<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://siai.ufscar/celula" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.16.0">
  <collaboration id="Collab_1">
    <participant id="Part_Cliente" name="Cliente" />
    <participant id="Part_ONS" name="ONS (simulada)" />
    <participant id="Part_Celula" name="Célula de Manufatura Energeticamente Autônoma" processRef="Proc_Celula" />
    <messageFlow id="mf2" name="tarifa + estado da rede" sourceRef="t_consultar" targetRef="Part_ONS" />
    <messageFlow id="mf3" name="fatura / OS fechada" sourceRef="t_faturar" targetRef="Part_Cliente" />
    <messageFlow id="mf1" name="Ordem de Serviço" sourceRef="Part_Cliente" targetRef="start" />
  </collaboration>
  <process id="Proc_Celula" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_C" name="Execução Física (CLP · SFC/Ladder)">
        <flowNodeRef>t_bat</flowNodeRef>
        <flowNodeRef>gw_merge</flowNodeRef>
        <flowNodeRef>t_regprod</flowNodeRef>
        <flowNodeRef>t_rede</flowNodeRef>
        <flowNodeRef>Activity_0c8lx9s</flowNodeRef>
        <childLaneSet id="LaneSet_07p4uqb" />
      </lane>
      <lane id="Lane_B" name="Controle Energético (CLP · ST)">
        <flowNodeRef>t_timer</flowNodeRef>
        <flowNodeRef>t_pausar</flowNodeRef>
        <flowNodeRef>t_consultar</flowNodeRef>
        <flowNodeRef>t_custo</flowNodeRef>
        <flowNodeRef>gw_dec</flowNodeRef>
      </lane>
      <lane id="Lane_A" name="Gestão de Produção (Negócio)">
        <flowNodeRef>gw_qtd</flowNodeRef>
        <flowNodeRef>t_fechar</flowNodeRef>
        <flowNodeRef>end</flowNodeRef>
        <flowNodeRef>start</flowNodeRef>
        <flowNodeRef>t_reg</flowNodeRef>
        <flowNodeRef>t_faturar</flowNodeRef>
      </lane>
    </laneSet>
    <dataStoreReference id="ds_sql" name="Histórico de Produção (SQL)" />
    <task id="t_regprod" name="Registrar produção e consumo">
      <incoming>Flow_0w2uorh</incoming>
      <outgoing>f15</outgoing>
    </task>
    <exclusiveGateway id="gw_merge" name="Modo definido">
      <incoming>f12</incoming>
      <incoming>f11</incoming>
      <outgoing>f13</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="f13" sourceRef="gw_merge" targetRef="Activity_0c8lx9s" />
    <task id="t_bat" name="Produzir da BATERIA">
      <incoming>f8</incoming>
      <outgoing>f12</outgoing>
    </task>
    <sequenceFlow id="f12" sourceRef="t_bat" targetRef="gw_merge" />
    <sequenceFlow id="f11" sourceRef="t_rede" targetRef="gw_merge" />
    <sequenceFlow id="fw" sourceRef="t_pausar" targetRef="t_timer" />
    <sequenceFlow id="f9" name="Ponta/Alerta + SOC insuficiente" sourceRef="gw_dec" targetRef="t_pausar" />
    <sequenceFlow id="f8" name="Ponta/Alerta + SOC suficiente" sourceRef="gw_dec" targetRef="t_bat" />
    <sequenceFlow id="f7" name="Normal / fora de ponta" sourceRef="gw_dec" targetRef="t_rede" />
    <sequenceFlow id="f6" sourceRef="t_custo" targetRef="gw_dec" />
    <sequenceFlow id="f5" sourceRef="t_consultar" targetRef="t_custo" />
    <sequenceFlow id="f10" name="Reavaliar" sourceRef="t_timer" targetRef="t_consultar" />
    <endEvent id="end" name="OS concluída">
      <incoming>f17</incoming>
    </endEvent>
    <sequenceFlow id="f17" sourceRef="t_faturar" targetRef="end" />
    <task id="t_fechar" name="Fechar OS">
      <incoming>f4</incoming>
      <outgoing>f16</outgoing>
    </task>
    <sequenceFlow id="f16" sourceRef="t_fechar" targetRef="t_faturar" />
    <exclusiveGateway id="gw_qtd" name="Peças produzidas &#60; qtd da OS?">
      <incoming>f15</incoming>
      <incoming>f2</incoming>
      <outgoing>f4</outgoing>
      <outgoing>f3</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="f4" name="Não" sourceRef="gw_qtd" targetRef="t_fechar" />
    <sequenceFlow id="f3" name="Sim" sourceRef="gw_qtd" targetRef="t_consultar" />
    <sequenceFlow id="f15" name="Nova peça" sourceRef="t_regprod" targetRef="gw_qtd" />
    <sequenceFlow id="f2" sourceRef="t_reg" targetRef="gw_qtd" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="t_reg" />
    <startEvent id="start" name="OS recebida">
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="t_reg" name="Registrar OS">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>
    <task id="t_faturar" name="Faturar OS">
      <incoming>f16</incoming>
      <outgoing>f17</outgoing>
    </task>
    <intermediateCatchEvent id="t_timer" name="aguardar Δt">
      <incoming>fw</incoming>
      <outgoing>f10</outgoing>
      <timerEventDefinition />
    </intermediateCatchEvent>
    <task id="t_pausar" name="Pausar / enfileirar">
      <incoming>f9</incoming>
      <outgoing>fw</outgoing>
    </task>
    <task id="t_rede" name="Produzir da REDE">
      <incoming>f7</incoming>
      <outgoing>f11</outgoing>
    </task>
    <task id="t_consultar" name="Consultar estado ONS + tarifa">
      <incoming>f10</incoming>
      <incoming>f3</incoming>
      <outgoing>f5</outgoing>
    </task>
    <task id="t_custo" name="Calcular custo por peça">
      <incoming>f5</incoming>
      <outgoing>f6</outgoing>
    </task>
    <exclusiveGateway id="gw_dec" name="Decisão energética">
      <incoming>f6</incoming>
      <outgoing>f9</outgoing>
      <outgoing>f8</outgoing>
      <outgoing>f7</outgoing>
    </exclusiveGateway>
    <task id="Activity_0c8lx9s" name="Ciclo físico (usinar → inspecionar → separar)">
      <incoming>f13</incoming>
      <outgoing>Flow_0w2uorh</outgoing>
    </task>
    <sequenceFlow id="Flow_0w2uorh" sourceRef="Activity_0c8lx9s" targetRef="t_regprod" />
    <association id="a1" sourceRef="t_regprod" targetRef="ds_sql" />
  </process>
